class Solution:
    def maxArea(self, a: List[int]) -> int:
        left = 0
        right = len(a)-1
        max_a = 0

        while left < right:
            height = min(a[left] , a[right])
            width = right - left
            area = height * width

            if area > max_a:
                max_a = area

            if a[left] < a[right]:
                left += 1
            else:
                right -= 1

        return max_a
