class Solution:
    def addTwoNumbers(self, l1: Optional[ListNode], l2: Optional[ListNode]) -> Optional[ListNode]:
        
        dummy = ListNode(0)
        current = dummy
        carry = 0

        while l1 or l2 or carry:
            if l1 is not None:
                val1 = l1.val
            else:
                val1 = 0

            if l2 is not None:
                val2 = l2.val
            else:
                val2 = 0 

            total = val1 + val2 + carry
            carry = total // 10

            current.next = ListNode(total % 10)
            current = current.next

            if l1 is not None:
                l1 = l1.next
            else:
                l1 = None

            if l2 is not None:
                l2 = l2.next
            else:
                l2 = None 

        return dummy.next                             
