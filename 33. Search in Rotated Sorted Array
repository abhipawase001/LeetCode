class Solution:
    def search(self, a: List[int], target: int) -> int:
        
        left = 0
        right = len(a) - 1

        while left <= right:
            
            mid = (left + right) // 2

            if a[mid] == target:
                return mid
              

            if a[left] <= a[mid]:
                if a[left] <= target < a[mid]:
                    right = mid -1

                else:
                    left = mid + 1
                    
            else:
                if a[mid] < target <= a[right]:
                    left = mid + 1

                else:
                    right = mid - 1    
        return -1
                             
