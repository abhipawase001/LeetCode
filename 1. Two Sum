//Optimal Approch : ( Using Hash-Map )

class Solution:
    def twoSum(self, a: List[int], target: int) -> List[int]:

        seen = {}
        for i, num in enumerate(a):
            total = target - num
            if total in seen:
                return [seen[total] , i]
            seen[num] = i

