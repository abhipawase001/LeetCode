class Solution:
    def trap(self, h: List[int]) -> int:
        
        left = 0
        right = len(h)-1
        leftmax = h[left]
        rightmax = h[right]
        water_trapped = 0

        while left < right:
            if leftmax < rightmax:
                left += 1
                leftmax = max(leftmax , h[left])
                water_trapped += leftmax - h[left]

            else:
                right -= 1
                rightmax = max(rightmax , h[right])
                water_trapped += rightmax - h[right]
        return water_trapped
