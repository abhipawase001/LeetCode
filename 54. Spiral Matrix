from typing import List

class Solution:
    def spiralOrder(self, a: List[List[int]]) -> List[int]:
  
        if not a or not a[0]:
            return []
            
        left = 0 
        right = len(a[0]) - 1
        top = 0
        bottom = len(a) - 1
        result = []
        
        while top <= bottom and left <= right:
            
            for ele in range(left, right + 1):
                result.append(a[top][ele])
            top += 1  
            
            for ele in range(top, bottom + 1):
                result.append(a[ele][right])
            right -= 1
               
            if top <= bottom:
                for ele in range(right, left - 1, -1):
                    result.append(a[bottom][ele])
                bottom -= 1  
        
            if left <= right:
                for ele in range(bottom, top - 1, -1):
                    result.append(a[ele][left])
                left += 1  
            
        return result
