class Solution:
    def removeNthFromEnd(self, head: ListNode | None, n: int) -> ListNode | None:
        curr = head
        len = 0

        while curr is not None:
            len += 1
            curr = curr.next
        
        if len == n:
            return head.next

        curr = head
        for _ in range(len - n - 1):
            curr = curr.next

        curr.next = curr.next.next
        return head
