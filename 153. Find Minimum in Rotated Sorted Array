class Solution:
    def findMin(self, a: List[int]) -> int:
        left = 0
        right = len(a) - 1

        while left < right:
            
            mid = (left + right) // 2

            if a[mid] < a[right] :
                right = mid

            else:
                left = mid + 1
        
        return a[left]           
